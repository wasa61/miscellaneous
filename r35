        filtered_m, filtered_v = [], []
        for _, _, iv, m, _ in meta:
            if abs(iv - fit_avg(m)) < self.outlier_threshold:
                filtered_m.append(m)
                filtered_v.append(iv)
        if len(filtered_m) >= 3:
            trader_data["coeff_history"].append(np.polyfit(filtered_m, filtered_v, 2).tolist())

        total_delta = 0.0

        for symbol, K, iv, m, option_mid in meta:
            fit_iv = fit_avg(m)
            rel_diff = iv - fit_iv
            delta_val = self.delta(spot, K, TTE, iv)
            pos = self.position[symbol]
            total_delta += delta_val * pos

            # 1. 吃单套利
            try:
                best_ask = min(self.order_depths[symbol].sell_orders)
                best_bid = max(self.order_depths[symbol].buy_orders)
            except:
                continue

            if abs(rel_diff) >= self.entry_threshold:
                is_underpriced = rel_diff < 0
                is_buy = is_underpriced
                best_price = best_ask if is_buy else best_bid
                expected_profit = abs(option_mid - best_price)

                if expected_profit >= self.min_profit_threshold:
                    volume = abs(self.order_depths[symbol].sell_orders[best_ask]) if is_buy else \
                             self.order_depths[symbol].buy_orders[best_bid]
                    max_vol = self.get_max_position_volume(symbol, is_buy)
                    trade_volume = min(volume, max_vol)
                    if trade_volume > 0:
                        self.consume_best(symbol, trade_volume, is_buy, orders)
                        trader_data["pair_trade_log"].append({
                            "timestamp": state.timestamp,
                            "symbol": symbol,
                            "side": "buy" if is_buy else "sell",
                            "volume": trade_volume,
                            "profit_est": expected_profit
                        })

            # 2. 清仓逻辑
            if pos != 0:
                is_buy = pos < 0
                orderbook = self.get_orderbook(symbol, is_buy)
                if not orderbook:
                    continue
                best_price = min(orderbook) if is_buy else max(orderbook)
                mid_price = get_mid_price(state, symbol, 'mid_price', 0)
                expected_profit = abs(best_price - mid_price)
